# Copy to .env (never commit .env).

# collector: where raw API responses and the ID list are written (keep it outside the repo)
COLLECTOR_DATA_DIR=~/gametrend-data
# collector: Roblox explore-sort countries, comma-separated
COLLECTOR_ROBLOX_COUNTRIES=us,br,pl

# mockapi: archive to serve (default: COLLECTOR_DATA_DIR), address
MOCKAPI_DATA_DIR=~/gametrend-data
MOCKAPI_HOST=127.0.0.1
MOCKAPI_PORT=8080
# mockapi: replay clock (A = REPLAY_A0 + (now - REPLAY_START) * REPLAY_SPEED); keep A0 and START fixed to resume
# after a restart. Empty = archive start / now.
REPLAY_A0=
REPLAY_START=
REPLAY_SPEED=1
# mockapi: replay archived error windows (replay|off) and probability of injected errors per request
MOCKAPI_ERRORS=replay
MOCKAPI_INJECT=0

# ingestion: mock (poll the mock API) or real (the real APIs; needs tracked_games, not built yet)
INGEST_MODE=mock
INGEST_MOCK_URL=http://127.0.0.1:8080
# ingestion: Kafka bootstrap servers (127.0.0.1:9094 from this computer, kafka:9092 from a container)
KAFKA_BOOTSTRAP=127.0.0.1:9094
# MongoDB for processes on this computer; containers get mongodb://mongodb:27017/?replicaSet=rs0 from docker-compose.yml
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
# ingestion: Roblox explore-sort countries, comma-separated
INGEST_ROBLOX_COUNTRIES=us,br,pl
# ingestion: divides every polling interval; set it to the mock's REPLAY_SPEED when replaying faster
INGEST_SPEED=1
